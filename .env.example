# Supabase — copy to .env.local and fill from:
# Dashboard → Project Settings → API (Project URL + anon public key)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Sentry (https://sentry.io) — errors + tagged SCORM export failures
# Create a Next.js project and paste the DSN. Vercel: Project → Settings → Environment Variables
NEXT_PUBLIC_SENTRY_DSN=
# Optional server-only override (otherwise NEXT_PUBLIC_SENTRY_DSN is used)
# SENTRY_DSN=

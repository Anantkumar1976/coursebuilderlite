# Supabase — copy to .env.local and fill from:
# Dashboard → Project Settings → API (Project URL + anon public key)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Sentry (https://sentry.io) — errors + tagged SCORM export failures
# Create a Next.js project and paste the DSN. Vercel: Project → Settings → Environment Variables
NEXT_PUBLIC_SENTRY_DSN=
# Optional server-only override (otherwise NEXT_PUBLIC_SENTRY_DSN is used)
# SENTRY_DSN=

# PayPal subscriptions (server-side only). Sandbox vs live must match the Developer app + webhook.
# PAYPAL_MODE=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET=
# PAYPAL_PLAN_ID_STARTER=
# PAYPAL_PLAN_ID_PRO=
#
# Webhook (production example URL):
#   https://coursebuilderlite.vercel.app/api/billing/paypal/webhook
# In PayPal Developer → your REST app → Webhooks → add that URL, then subscribe to:
#   BILLING.SUBSCRIPTION.ACTIVATED, BILLING.SUBSCRIPTION.CANCELLED,
#   BILLING.SUBSCRIPTION.SUSPENDED, BILLING.SUBSCRIPTION.EXPIRED
# Copy the webhook’s ID into:
# PAYPAL_WEBHOOK_ID=

# Required for webhook-driven subscription status updates AND for seeding scripts
# (e.g. scripts/seed-zero-by-30.ts) — server only, never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# Master admin account (full platform rights + subscription bypass).
# MASTER_ADMIN_EMAIL=anant@abanyantree.com

# Optional: Resend (https://resend.com) for transactional email — team invites
# RESEND_API_KEY=
# From address must use a verified domain in Resend (sandbox: onboarding@resend.dev)
# RESEND_FROM="Course Builder Light <invites@yourdomain.com>"

# Absolute site URL for auth redirects, team invite links, etc.
# Required in production (e.g. https://coursebuilderlite.vercel.app).
# Also configure Supabase → Authentication → URL Configuration:
#   Site URL = https://your-production-domain  (NOT localhost)
#   Redirect URLs:
#     http://localhost:3000/auth/callback
#     https://your-production-domain/auth/callback
#     https://your-production-domain/**
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
